{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "msfslogger",
  "version": "0.1.0",
  "identifier": "com.msfslogger.windows-client",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": { "script": "npm --prefix sidecar run build", "cwd": "..", "wait": true },
    "beforeBuildCommand": { "script": "npm --prefix sidecar run build", "cwd": ".." }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "msfslogger — ACARS",
      "width": 560,
      "height": 820,
      "minWidth": 488,
      "minHeight": 680,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "../sidecar/dist": "sidecar/dist",
      "../sidecar/node_modules": "sidecar/node_modules",
      "../sidecar/package.json": "sidecar/package.json"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
