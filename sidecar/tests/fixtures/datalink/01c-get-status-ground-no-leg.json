{
  "_sample": "GET /api/status with neither a flight nor a groundSession.plannedLegId -> the selector falls back to GET /api/ground-sessions/current.",
  "request": {
    "method": "GET",
    "path": "/api/status",
    "headers": {
      "x-ingest-token": "SENTINEL-DATALINK-TOKEN-0000",
      "accept": "application/json"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "connected": false,
      "flightState": "IDLE",
      "currentFlightId": null,
      "paused": false,
      "pauseFlags": 0,
      "simRunning": 0,
      "onGround": true,
      "aircraft": null,
      "frame": null
    }
  }
}
