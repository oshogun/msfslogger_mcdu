      "currentFlightId": null,
      "paused": false,
      "pauseFlags": 0,
      "simRunning": 2,
      "onGround": true,
      "aircraft": "A320",
      "frame": null,
      "groundSession": {
        "groundSessionId": 4,
        "plannedLegId": 12
      }
    }
  }
}
