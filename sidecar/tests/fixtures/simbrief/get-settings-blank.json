{
  "_sample": "get-settings-blank",
  "_why": "A whitespace-only id is treated as not configured, so PREFILE stays hidden.",
  "request": {
    "method": "GET",
    "path": "/api/settings/simbrief",
    "headers": {
      "x-ingest-token": "SENTINEL-SIMBRIEF-TOKEN-0000",
      "accept": "application/json"
    },
    "body": null
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "simbrief_user_id": "   "
    }
  },
  "expect": {
    "ok": true,
    "result": {
      "configured": false
    },
    "cdu": "NOT SET",
    "hint": "SET PILOT ID ON SERVER"
  }
}
